# ==============================================================================
# XpertStream: Git Ignore Configuration
# ==============================================================================

# Python environments and bytecode
.venv*/
venv*/
env*/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/

# Model Weights & Compiled Graphs (NEVER commit large binaries or model weights)
models/
*.bin
*.xml
*.blob
*.safetensors
*.onnx
*.pt
*.pth
cache_npu/
openvino_cache/
*.cl_cache

# Secrets, Credentials & Local Tokens (Strictly protected)
.env
.env.*
*.token
*.key
*.pem
.huggingface/
hf_token*

# OS & IDE local files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
*.vsix
demo-project/tasks.json
.opencode-xpert.json
